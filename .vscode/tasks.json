{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sql ide",
            "type": "shell",
            "command": "cd '${workspaceFolder}/../DataSpark_SQL-IDE'; Remove-Item -Path dist, dist-embedded -Recurse -Force -ErrorAction SilentlyContinue; npm run build",
            "dependsOn": [
                "remove old sql ide"
            ]
        },
        {
            "label": "remove old sql ide",
            "type": "shell",
            "command": "Remove-Item '${workspaceFolder}/tutorial/myapp/staticfiles/sql-ide/*' -Recurse -Force -ErrorAction SilentlyContinue"
        },
        {
            "label": "copy sql ide",
            "type": "shell",
            "command": "cd '${workspaceFolder}/../DataSpark_SQL-IDE/dist-embedded' ; copy-Item * -Destination '${workspaceFolder}/tutorial/myapp/staticfiles/sql-ide' -Recurse -force",
            "dependsOn": [
                "build sql ide"
            ]
        },
        {
            "label": "copy apollon",
            "type": "shell",
            "command": "cd '${workspaceFolder}/../DataSpark_Apollon/dist' ; copy-Item * -Destination '${workspaceFolder}/tutorial/myapp/staticfiles/apollon' -Recurse -force",
            "dependsOn": [
                "build apollon"
            ]
        },
        {
            "label": "copy apollon",
            "type": "shell",
            "command": "cd '${workspaceFolder}/../DataSpark_Apollon/dist' ; copy-Item * -Destination '${workspaceFolder}/tutorial/myapp/staticfiles/apollon' -Recurse -force",
            "dependsOn": [
                "build apollon"
            ]
        },
        {
            "label": "venv",
            "type": "shell",
            "command": "source ${workspaceFolder}/.venv/bin/activate ; pip install -r ${workspaceFolder}/requirements.txt",
            "dependsOn": [
                "copy sql ide",
                "copy apollon"
            ]
        },
        {
            "label": "makemigrations",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/tutorial/manage.py makemigrations",
            "dependsOn": [
                "venv"
            ]
        },
        {
            "label": "migrate",
            "type": "shell",
            "command": "python3 '${workspaceFolder}/tutorial/manage.py' migrate",
            "dependsOn": [
                "makemigrations"
            ]
        },
        {
            "label": "collectstatic",
            "type": "shell",
            "command": "python3 '${workspaceFolder}/tutorial/manage.py' collectstatic --noinput",
            "dependsOn": [
                "migrate"
            ]
        },
        {
            "label": "PreLaunchRoutine",
            "dependsOn": [
                "collectstatic"
            ]
        },
        {
            "label": "venv_simple",
            "type": "shell",
            "command": "source ${workspaceFolder}/.venv/bin/activate ; pip install -r ${workspaceFolder}/requirements.txt",
            "dependsOn": []
        },
        {
            "label": "makemigrations_simple",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/tutorial/manage.py makemigrations",
            "dependsOn": [
                "venv_simple"
            ]
        },
        {
            "label": "migrate_simple",
            "type": "shell",
            "command": "python3 '${workspaceFolder}/tutorial/manage.py' migrate",
            "dependsOn": [
                "makemigrations_simple"
            ]
        },
        {
            "label": "collectstatic_simple",
            "type": "shell",
            "command": "python3 '${workspaceFolder}/tutorial/manage.py' collectstatic --noinput",
            "dependsOn": [
                "migrate_simple"
            ]
        },
        {
            "label": "PreLaunchRoutine_simple",
            "type": "shell",
            "command": "source ${workspaceFolder}/.venv/bin/activate ; pip install -r ${workspaceFolder}/requirements.txt ; python3 ${workspaceFolder}/tutorial/manage.py makemigrations  ; python3 ${workspaceFolder}/tutorial/manage.py migrate ; python3 '${workspaceFolder}/tutorial/manage.py' collectstatic --noinput"
        },
        {
            "type": "docker-build",
            "label": "docker-build",
            "platform": "python",
            "dockerBuild": {
                "tag": "sqlution:latest",
                "dockerfile": "${workspaceFolder}/Dockerfile",
                "context": "${workspaceFolder}",
                "pull": true
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build"
            ],
            "dockerRun": {
                "ports": [
                    {
                        "containerPort": 8000,
                        "hostPort": 8000
                    },
                    {
                        "containerPort": 5678,
                        "hostPort": 5678
                    }
                ],
                "customOptions": "--memory=1g"
            },
            "python": {
                "args": [
                    "runserver",
                    "0.0.0.0:8000",
                    "--nothreading",
                    "--noreload"
                ],
                "file": "manage.py"
            }
        },
        {
            "label": "docker-stop: debug",
            "type": "shell",
            "command": "docker rm -f sqlution-dev >/dev/null 2>&1 || true"
        }
    ]
}
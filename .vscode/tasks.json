{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build sql ide",
            "type": "shell",
            "command": "SOURCE='${workspaceFolder}/../DataSpark_SQL-IDE'; if [ -d \"$SOURCE\" ]; then cd \"$SOURCE\" && rm -rf dist dist-embedded && npm run build; else echo '[sql-ide] Source repository not found, skipping build'; fi",
            "dependsOn": [
                "remove old sql ide"
            ]
        },
        {
            "label": "remove old sql ide",
            "type": "shell",
            "command": "TARGET='${workspaceFolder}/tutorial/myapp/staticfiles/sql-ide'; if [ -d \"$TARGET\" ]; then rm -rf \"$TARGET\"/*; fi"
        },
        {
            "label": "copy sql ide",
            "type": "shell",
            "command": "SOURCE='${workspaceFolder}/../DataSpark_SQL-IDE/dist-embedded'; TARGET='${workspaceFolder}/tutorial/myapp/staticfiles/sql-ide'; if [ -d \"$SOURCE\" ]; then mkdir -p \"$TARGET\" && cp -a \"$SOURCE\"/. \"$TARGET\"/; else echo '[sql-ide] Build artifacts not found, skipping copy'; fi",
            "dependsOn": [
                "build sql ide"
            ]
        },
        {
            "label": "build apollon",
            "type": "shell",
            "command": "SOURCE='${workspaceFolder}/../DataSpark_Apollon'; if [ -d \"$SOURCE\" ]; then cd \"$SOURCE\" && npm run build; else echo '[apollon] Source repository not found, skipping build'; fi"
        },
        {
            "label": "copy apollon",
            "type": "shell",
            "command": "SOURCE='${workspaceFolder}/../DataSpark_Apollon/dist'; TARGET='${workspaceFolder}/tutorial/myapp/staticfiles/apollon'; if [ -d \"$SOURCE\" ]; then mkdir -p \"$TARGET\" && cp -a \"$SOURCE\"/. \"$TARGET\"/; else echo '[apollon] Build artifacts not found, skipping copy'; fi",
            "dependsOn": [
                "build apollon"
            ]
        },
        {
            "label": "sync embedded frontends",
            "dependsOn": [
                "copy sql ide",
                "copy apollon"
            ]
        },
        {
            "label": "venv",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m pip install -r ${workspaceFolder}/requirements.txt",
            "dependsOn": [
                "copy sql ide",
                "copy apollon"
            ]
        },
        {
            "label": "makemigrations",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py makemigrations",
            "dependsOn": [
                "venv"
            ]
        },
        {
            "label": "migrate",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py migrate",
            "dependsOn": [
                "makemigrations"
            ]
        },
        {
            "label": "collectstatic",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py collectstatic --noinput",
            "dependsOn": [
                "migrate"
            ]
        },
        {
            "label": "PreLaunchRoutine",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m pip install -r ${workspaceFolder}/requirements.txt",
            "dependsOn": [
                "collectstatic"
            ]
        },
        {
            "label": "venv_simple",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m pip install -r ${workspaceFolder}/requirements.txt",
            "dependsOn": []
        },
        {
            "label": "makemigrations_simple",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py makemigrations",
            "dependsOn": [
                "venv_simple"
            ]
        },
        {
            "label": "migrate_simple",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py migrate",
            "dependsOn": [
                "makemigrations_simple"
            ]
        },
        {
            "label": "collectstatic_simple",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py collectstatic --noinput",
            "dependsOn": [
                "migrate_simple"
            ]
        },
        {
            "label": "PreLaunchRoutine_simple",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m pip install -r ${workspaceFolder}/requirements.txt ; ${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py makemigrations ; ${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py migrate ; ${workspaceFolder}/.venv/bin/python ${workspaceFolder}/tutorial/manage.py collectstatic --noinput"
        },
        {
            "type": "docker-build",
            "label": "docker-build",
            "dependsOn": [
                "sync embedded frontends"
            ],
            "platform": "python",
            "dockerBuild": {
                "tag": "sqlution:latest",
                "dockerfile": "${workspaceFolder}/Dockerfile",
                "context": "${workspaceFolder}",
                "pull": true
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build"
            ],
            "dockerRun": {
                "containerName": "sqlution-dev",
                "ports": [
                    {
                        "containerPort": 8000,
                        "hostPort": 8000
                    },
                    {
                        "containerPort": 5678,
                        "hostPort": 5678
                    }
                ],
                "customOptions": "--memory=1g"
            },
            "python": {
                "args": [
                    "runserver",
                    "0.0.0.0:8000",
                    "--nothreading",
                    "--noreload"
                ],
                "file": "manage.py"
            }
        },
        {
            "label": "docker-stop: debug",
            "type": "shell",
            "command": "docker rm -f sqlution-dev >/dev/null 2>&1 || true"
        }
    ]
}
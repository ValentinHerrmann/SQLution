{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Full",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "localhost:8000"
            ],
            "django": true,
            "program": "${workspaceFolder}/tutorial/manage.py",
            "console": "internalConsole",
            "preLaunchTask": "PreLaunchRoutine",
            "serverReadyAction": {
                "pattern": "Starting development server at http://localhost:([0-9]+)/",
                "action": "startDebugging",
                "name": "Launch Firefox Session"
            }
        },
        {
            "name": "Django Basic",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "localhost:8000"
            ],
            "django": true,
            "program": "${workspaceFolder}/tutorial/manage.py",
            "console": "internalConsole",
            "serverReadyAction": {
                "pattern": "Starting development server at http://localhost:([0-9]+)/",
                "action": "startDebugging",
                "name": "Launch Firefox Session"
            }
        },
        {
            "name": "Django Simple",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "localhost:8000"
            ],
            "django": true,
            "program": "${workspaceFolder}/tutorial/manage.py",
            "console": "internalConsole",
            "preLaunchTask": "PreLaunchRoutine_simple",
            "serverReadyAction": {
                "pattern": "Starting development server at http://localhost:([0-9]+)/",
                "action": "startDebugging",
                "name": "Launch Firefox Session"
            }
        },
        {
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "name": "Launch Firefox Session",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}/tutorial/",
            "skipFiles": [
                "**/node_modules/**"
            ],
            "firefoxArgs": [
                "-start-debugger-server"
            ]
        },
        {
            "name": "Containers: Python - Django",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "postDebugTask": "docker-stop: debug",
            "python": {
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder}/tutorial",
                        "remoteRoot": "/app/tutorial"
                    }
                ],
                "projectType": "django"
            }
        }
    ]
}